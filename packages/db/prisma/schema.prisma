// Esquema inicial de Hyvento Office.
// Fase 0/2: usuarios, invitaciones, oficinas, chat. Fase 4+: agentes, tareas, artefactos, logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Personas ----------

enum Role {
  ADMIN
  MEMBER
}

enum PresenceStatus {
  AVAILABLE
  BUSY
  DND
  AWAY
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String
  avatar    String         @default("ada")
  role      Role           @default(MEMBER)
  status    PresenceStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  office       Office?
  chatMessages ChatMessage[]
  tasks        Task[]
  invitesSent  Invite[]      @relation("InvitedBy")

  // Auth.js (adapter de Prisma) — se conecta en la Fase 0 cuando haya Postgres.
  accounts Account[]
  sessions Session[]
}

/** Acceso solo por invitación: únicamente correos invitados pueden entrar. */
model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role      @default(MEMBER)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/** Oficina personal: una zona `office-<slot>` del mapa asignada a un usuario. */
model Office {
  id       String  @id @default(cuid())
  zoneId   String  @unique // p. ej. "office-2" (zoneId en Tiled)
  name     String
  ownerId  String? @unique
  owner    User?   @relation(fields: [ownerId], references: [id])
  isLocked Boolean @default(false) // cerrada: hay que tocar la puerta
  notes    String  @default("")
}

enum ChatScope {
  PROXIMITY
  GLOBAL
}

model ChatMessage {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  scope     ChatScope
  zoneId    String?
  text      String
  createdAt DateTime  @default(now())

  @@index([scope, createdAt])
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Agentes (Fase 4+) ----------

model AgentDefinition {
  id           String   @id @default(cuid())
  name         String
  role         String // "pm", "researcher", "writer", "developer", "qa", ...
  systemPrompt String
  model        String   @default("claude-opus-5")
  effort       String   @default("high")
  tools        String[] // herramientas habilitadas
  sprite       String   @default("bot-blue")
  deskId       String?  @unique // "desk-1".."desk-6" (agent_desk en Tiled)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subTasks     SubTask[]
  messagesFrom AgentMessage[] @relation("MessageFrom")
  runLogs      AgentRunLog[]
}

enum TaskStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_HUMAN
  DONE
  FAILED
  CANCELLED
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String
  status       TaskStatus @default(PENDING)
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id])
  /** Presupuesto máximo de tokens y costo acumulado (USD). */
  tokenBudget  Int        @default(500000)
  tokensUsed   Int        @default(0)
  costUsd      Decimal    @default(0) @db.Decimal(10, 4)
  /** Brief acumulado (espejo persistente de task:<id>:brief en Redis). */
  brief        String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subTasks  SubTask[]
  messages  AgentMessage[]
  artifacts Artifact[]
  runLogs   AgentRunLog[]
}

model SubTask {
  id           String           @id @default(cuid())
  taskId       String
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId      String
  agent        AgentDefinition  @relation(fields: [agentId], references: [id])
  instructions String
  status       TaskStatus       @default(PENDING)
  summary      String?
  dependsOn    String[] // ids de otras subtareas
  /** run_id + tool_use_id que la creó: evita duplicados en reintentos. */
  idempotencyKey String         @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AgentMessage {
  id             String          @id @default(cuid())
  taskId         String
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromAgentId    String?
  fromAgent      AgentDefinition? @relation("MessageFrom", fields: [fromAgentId], references: [id])
  fromUserId     String?
  toId           String // id de agente o de usuario
  content        String // corto: el trabajo pesado va en Artifact
  artifactIds    String[]
  readAt         DateTime?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  @@index([toId, readAt])
}

model Artifact {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name           String
  kind           String   @default("markdown") // markdown | json
  content        String
  version        Int      @default(1)
  createdBy      String // agent id
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@unique([taskId, name, version])
}

/** Eventos crudos de cada run (auditoría y replay en la oficina). */
model AgentRunLog {
  id        String          @id @default(cuid())
  taskId    String
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId   String
  agent     AgentDefinition @relation(fields: [agentId], references: [id])
  runId     String
  seq       Int
  type      String // agent.status | agent.move | agent.message | agent.tool | ...
  payload   Json
  createdAt DateTime        @default(now())

  @@unique([runId, seq])
  @@index([taskId, createdAt])
}
