// Esquema de Hyvento Office: usuarios, invitaciones, oficinas personales y chat.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Personas ----------

enum Role {
  ADMIN
  MEMBER
}

enum PresenceStatus {
  AVAILABLE
  BUSY
  DND
  AWAY
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String         @default("")
  avatar        String         @default("ada")
  /**
   * Personaje personalizado (colores, peinado y accesorios; ver Look en @hyvento/shared).
   * null = usa el personaje fijo de `avatar`.
   */
  look          Json?
  role          Role           @default(MEMBER)
  status        PresenceStatus @default(AVAILABLE)
  /**
   * Auth.js: nombre/foto de Google. `name` arriba es el nombre visible en la oficina.
   */
  image         String?
  emailVerified DateTime?
  /**
   * Completó el onboarding (eligió nombre visible y avatar).
   */
  onboardedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  office       Office?
  chatMessages ChatMessage[]
  notes        Note[]
  invitesSent  Invite[]      @relation("InvitedBy")

  // Auth.js (adapter de Prisma) — se conecta en la Fase 0 cuando haya Postgres.
  accounts Account[]
  sessions Session[]
}

/**
 * Acceso solo por invitación: únicamente correos invitados pueden entrar.
 */
model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role      @default(MEMBER)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/**
 * Oficina personal: una zona `office-<slot>` del mapa asignada a un usuario.
 */
model Office {
  id       String  @id @default(cuid())
  zoneId   String  @unique // p. ej. "office-2" (zoneId en Tiled)
  name     String
  ownerId  String? @unique
  owner    User?   @relation(fields: [ownerId], references: [id])
  isLocked Boolean @default(false) // cerrada: hay que tocar la puerta
  /** Obsoleto: las notas pasaron a Note (se conserva mientras conviven versiones). */
  notes    String  @default("")
}

enum ChatScope {
  PROXIMITY
  GLOBAL
}

/**
 * Nota personal (app de Notas del computador de la oficina). Solo la ve su dueño, desde
 * cualquier PC. Con `deletedAt` está en la papelera hasta que se vacíe.
 */
model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("")
  /** Texto plano de la nota (para buscar y para la vista previa en la lista). */
  body      String    @default("")
  /** Documento del editor (bloques, formato, tablas…). null = nota antigua: se arma desde `body`. */
  content   Json?
  /** Subpágina de otra nota (null = en la raíz). Borrar la madre borra sus subpáginas. */
  parentId  String?
  parent    Note?     @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Note[]    @relation("NoteTree")
  favorite  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@index([parentId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  scope     ChatScope
  zoneId    String?
  text      String
  createdAt DateTime  @default(now())

  @@index([scope, createdAt])
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
