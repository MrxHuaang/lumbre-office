// Esquema de Hyvento Office: usuarios, invitaciones, oficinas personales, chat, notas y puntos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Personas ----------

enum Role {
  ADMIN
  MEMBER
}

enum PresenceStatus {
  AVAILABLE
  BUSY
  DND
  AWAY
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String         @default("")
  avatar        String         @default("ada")
  /**
   * Personaje personalizado (colores, peinado y accesorios; ver Look en @hyvento/shared).
   * null = usa el personaje fijo de `avatar`.
   */
  look          Json?
  role          Role           @default(MEMBER)
  status        PresenceStatus @default(AVAILABLE)
  /**
   * Auth.js: nombre/foto de Google. `name` arriba es el nombre visible en la oficina.
   */
  image         String?
  emailVerified DateTime?
  /**
   * Completó el onboarding (eligió nombre visible y avatar).
   */
  onboardedAt   DateTime?
  /**
   * Saldo de puntos (la suma de sus PointTransaction; se actualiza en la misma transacción).
   */
  points        Int            @default(0)
  /**
   * Días seguidos reclamando la recompensa del buzón, y cuándo fue el último reclamo.
   */
  streak        Int            @default(0)
  lastDailyAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  office          Office?
  chatMessages    ChatMessage[]
  notes           Note[]
  invitesSent     Invite[]           @relation("InvitedBy")
  pointMoves      PointTransaction[]
  missionsCreated Mission[]          @relation("MissionCreator")
  missionsTaken   Mission[]          @relation("MissionAssignee")

  // Auth.js (adapter de Prisma) — se conecta en la Fase 0 cuando haya Postgres.
  accounts Account[]
  sessions Session[]
}

/**
 * Acceso solo por invitación: únicamente correos invitados pueden entrar.
 */
model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        Role      @default(MEMBER)
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/**
 * Oficina personal: una zona `office-<slot>` del piso 2 de la cabaña asignada a un usuario.
 */
model Office {
  id       String  @id @default(cuid())
  zoneId   String  @unique // p. ej. "office-2" (id de la zona en packages/map)
  name     String
  ownerId  String? @unique
  owner    User?   @relation(fields: [ownerId], references: [id])
  isLocked Boolean @default(false) // cerrada: hay que tocar la puerta
  /**
   * Obsoleto: las notas pasaron a Note (se conserva mientras conviven versiones).
   */
  notes    String  @default("")
}

enum ChatScope {
  PROXIMITY
  GLOBAL
}

/**
 * Nota personal (app de Notas del computador de la oficina). Solo la ve su dueño, desde
 * cualquier PC. Con `deletedAt` está en la papelera hasta que se vacíe.
 */
model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("")
  /**
   * Texto plano de la nota (para buscar y para la vista previa en la lista).
   */
  body      String    @default("")
  /**
   * Documento del editor (bloques, formato, tablas…). null = nota antigua: se arma desde `body`.
   */
  content   Json?
  /**
   * Subpágina de otra nota (null = en la raíz). Borrar la madre borra sus subpáginas.
   */
  parentId  String?
  parent    Note?     @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Note[]    @relation("NoteTree")
  favorite  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@index([parentId])
}

model ChatMessage {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  scope     ChatScope
  zoneId    String?
  text      String
  createdAt DateTime  @default(now())

  @@index([scope, createdAt])
}

// ---------- Puntos (fase 2) ----------

enum PointReason {
  PRESENCE
  MEETING
  DAILY
  MISSION
  ADMIN
}

/**
 * Libro de puntos: cada movimiento (ganar o gastar). El saldo de User.points es la suma.
 */
model PointTransaction {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    PointReason
  /**
   * Referencia a lo que lo originó (p. ej. el id de una misión).
   */
  refId     String?
  createdAt DateTime    @default(now())

  @@index([userId, reason, createdAt])
  @@index([createdAt])
}

enum MissionStatus {
  OPEN
  TAKEN
  REVIEW
  DONE
  CANCELLED
}

/**
 * Misión del tablón: alguien la crea con una recompensa, otra persona la toma y la entrega, y quien la
 * creó (o un admin) la aprueba y se pagan los puntos.
 */
model Mission {
  id          String        @id @default(cuid())
  title       String
  description String        @default("")
  reward      Int
  status      MissionStatus @default(OPEN)
  createdById String
  createdBy   User          @relation("MissionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?         @relation("MissionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
