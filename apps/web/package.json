{
  "name": "@hyvento/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev --port 3000",
    "prebuild": "node scripts/copy-assets.mjs && pnpm --filter @hyvento/db generate",
    "build": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "dev:session": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs scripts/dev-session.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hyvento/db": "workspace:*",
    "@hyvento/map": "workspace:*",
    "@hyvento/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "colyseus.js": "^0.16.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.32",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
