{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet HEAD^ HEAD -- . ../../packages ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml ':!**/*.test.ts' ':!**/*.test.tsx' ':!e2e'",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "chore/**": false,
      "docs/**": false,
      "perf/**": false,
      "refactor/**": false,
      "test/**": false,
      "claude/**": false,
      "archivo/**": false
    }
  }
}
