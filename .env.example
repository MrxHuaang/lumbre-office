# ---------- Servidor de juego (Colyseus) ----------
GAME_SERVER_PORT=2567
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
# (Opcional) URL HTTP del servidor de juego para avisos internos; por defecto se deriva de la anterior.
# GAME_SERVER_HTTP_URL=http://localhost:2567
# Secreto compartido web ↔ servidor de juego para firmar el token de ingreso (≥ 32 caracteres).
GAME_TOKEN_SECRET=

# ---------- Supabase Auth (login con Google) ----------
# Supabase solo da la identidad; los usuarios y todo lo demás siguen en DATABASE_URL (Neon/Prisma).
# Supabase → Project Settings → API: "Project URL" y la llave "anon" (pública).
# En Authentication → URL Configuration agrega http://localhost:3000/auth/callback a Redirect URLs.
# Sin estas dos, el login local funciona igual con "Entrar de prueba".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (Opcional) URL pública del sitio, para las imágenes al compartir. En Vercel se deduce sola.
# NEXT_PUBLIC_SITE_URL=https://lumbre.hyvento.co
# Correos con rol admin que pueden entrar sin invitación (separados por coma).
ADMIN_EMAILS=

# ---------- Infraestructura (docker compose) ----------
DATABASE_URL=postgresql://hyvento:hyvento@localhost:5432/hyvento

# ---------- LiveKit (Fase 3) — valores del modo --dev ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Solo desarrollo: habilita "/ir <nivel> [punto]" (saltar por el mapa) y "/clima <tipo>" (forzar el clima)
# en el chat (apps/server/src/rooms/devtools.ts). En producción y en Render no hace nada.
# HYVENTO_DEV_TOOLS=1
