# ---------- Servidor de juego (Colyseus) ----------
GAME_SERVER_PORT=2567
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
# Secreto compartido web ↔ servidor de juego para firmar el token de ingreso (≥ 32 caracteres).
GAME_TOKEN_SECRET=

# ---------- Auth.js (login con Google) ----------
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Google Cloud Console → Credenciales → ID de cliente OAuth (Aplicación web)
#   Origen autorizado:       http://localhost:3000
#   URI de redirección:      http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Correos con rol admin que pueden entrar sin invitación (separados por coma).
ADMIN_EMAILS=

# ---------- Infraestructura (docker compose) ----------
DATABASE_URL=postgresql://hyvento:hyvento@localhost:5432/hyvento
REDIS_URL=redis://localhost:6379

# ---------- LiveKit (Fase 3) — valores del modo --dev ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---------- Agentes (Fase 4) ----------
ANTHROPIC_API_KEY=
